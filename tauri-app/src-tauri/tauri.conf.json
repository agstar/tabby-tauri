{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabby Tauri",
  "version": "0.0.0",
  "identifier": "io.github.tabby.tauri",
  "build": {
    "beforeDevCommand": "npm run check:no-electron && npm run build:tabby-web",
    "beforeBuildCommand": "npm run check:no-electron && npm run build:tabby-web",
    "devUrl": null,
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tabby Tauri",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "tabbed",
            "mica",
            "acrylic",
            "blur"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
